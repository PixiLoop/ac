  reportType            String                @default("SERVICE")
  filterServiceCode     String?
  filterOptionCode      String?
  sortBy                String?
  volumeOffsetMonths    Int                   @default(0)
  isActive              Boolean               @default(true)
  lastInvoicedPeriodEnd DateTime?
  startDate             DateTime?
  priceIncludesGst      Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  invoiceBy             invoice_by?
  listBy                list_by?
  reportTarget          report_target?
  listSpace             Decimal               @default(10) @db.Decimal
  listVol               Decimal               @default(0) @db.Decimal
  fmCustomer            FMCustomer            @relation(fields: [fmCustomerId], references: [id])
  invoices              Invoice[]
  fmSubscriptionItems   fmSubscriptionItems[]

  @@schema("admin")
}

model fmSubscriptionItems {
  id                   String               @id @default(cuid())
