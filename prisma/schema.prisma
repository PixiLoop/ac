  invoiceId            String
  label                String
  quantity             Int
  rate                 Decimal              @default(0) @db.Decimal
  total                Decimal              @default(0) @db.Decimal
  invoicePeriodMonths  Int
  Invoice              Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invoice")
  FMSubscriptionReport FMSubscriptionReport @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "subscription")

  @@schema("admin")
