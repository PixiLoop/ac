generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["admin", "auth", "inventory"]
}

model User {
  id                      String               @id @default(cuid())
  tenantId                String?
  email                   String               @unique
  firstName               String?
  lastName                String?
  displayName             String?
  phone                   String?
  profilePhotoUrl         String?
  passwordHash            String
  isActive                Boolean              @default(false)
  mustChangePassword      Boolean              @default(true)
  mfaEnabled              Boolean              @default(false)
  mfaSecret               String?
  secretQuestion          String?
  secretAnswerHash        String?
  lastLoginAt             DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  defaultLandingPage      String?
  deletedAt               DateTime?
  status                  userStatus?
  auditLogs               AuditLog[]           @relation("actorUser")
  cardActivities          CardActivity[]
  cardMemberships         CardMember[]
  DispatchedInvoices      DispatchedInvoices[]
  createdInstallationJobs InstallationJob[]    @relation("JobCreator")
  installationJobs        InstallationJob[]
  jobBoards               JobBoard[]
  timelineEvents          JobTimelineEvent[]   @relation("TimelineActor")
  jobTimelineEvents       JobTimelineEvent[]
  userJobs                UserJob[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]
  userRoles               UserRole[]

  @@schema("auth")
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?
  isActive        Boolean          @default(false)
  updatedAt       DateTime         @default(now()) @updatedAt
  isSystem        Boolean          @default(false)
  isTechnician    Boolean?         @default(false)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@schema("auth")
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@schema("auth")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@schema("auth")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@schema("auth")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorType  String?
  action     String
  entityType String?
  entityId   String?
  ip         String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("actorUser", fields: [actorId], references: [id])

  @@schema("admin")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])

  @@schema("auth")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  type      TokenType @default(PASSWORD_RESET)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("auth")
}

model Job {
  id           String    @id @default(cuid())
  jobNumber    String    @unique
  customer     String
  shortAddress String
  scheduledAt  DateTime?
  status       String    @default("scheduled")
  priority     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  deletedAt    DateTime?
  isActive     Boolean   @default(false)
  userJobs     UserJob[]

  @@schema("admin")
}

model UserJob {
  id         String   @id @default(cuid())
  userId     String
  jobId      String
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, jobId])
  @@schema("admin")
}

model Customer {
  id                      String             @id @default(cuid())
  customerNumber          String             @unique
  name                    String
  registeredName          String?
  abn                     String?
  gstNumber               String?
  status                  CustomerStatus     @default(ACTIVE)
  isGeneric               Boolean            @default(false)
  requiresShippingDetails Boolean            @default(false)
  fmCustomerNumber        String?
  orderRequired           Boolean            @default(false)
  creditLimit             Decimal?           @db.Decimal(12, 2)
  creditHold              Boolean            @default(false)
  creditHoldReason        String?
  gstExempt               Boolean            @default(false)
  priceLevel              PriceLevel         @default(RETAIL)
  paymentTerms            PaymentTerms       @default(DAYS_30)
  currentBalance          Decimal?           @db.Decimal(12, 2)
  overdueAmount           Decimal?           @db.Decimal(12, 2)
  primaryContactId        String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  deletedAt               DateTime?
  accountType             String?
  bankAccountName         String?
  bankAccountNo           String?
  bankBsb                 String?
  bankName                String?
  paymentMethod           String?
  salesFactor             Decimal?           @db.Decimal(6, 2)
  invoiceDelivery         String             @default("PRINT_WITH_GOODS")
  addresses               CustomerAddress[]
  contacts                CustomerContact[]
  dispatches              CustomerDispatch[]
  Depots                  Depots[]
  Dispatch                Dispatch[]
  fmCustomer              FMCustomer?
  fmPreinstalls           FMPreinstall[]
  installationJobs        InstallationJob[]
  invoices                Invoice[]
  Quotation               Quotation[]
  salesOrders             SalesOrder[]
  vehicles                Vehicle[]

  @@schema("admin")
}

model CustomerContact {
  id         String           @id @default(cuid())
  customerId String
  email      String
  phone      String?
  fax        String?
  role       ContactRole
  isPrimary  Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?
  firstName  String
  lastName   String
  category   contactCategory?
  customer   Customer         @relation(fields: [customerId], references: [id])

  @@schema("admin")
}

model CustomerAddress {
  id         String      @id @default(cuid())
  customerId String
  type       AddressType
  name       String?
  address1   String
  address2   String?
  address3   String?
  city       String?
  state      String?
  postcode   String?
  country    String?
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  customer   Customer    @relation(fields: [customerId], references: [id])

  @@schema("admin")
}

model DispatchMethod {
  id                 String               @id @default(cuid())
  code               String               @unique
  label              String
  isActive           Boolean              @default(true)
  sortOrder          Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  DispatchedInvoices DispatchedInvoices[]

  @@schema("admin")
}

model CustomerDispatch {
  id          String    @id @default(cuid())
  customerId  String
  method      String
  accountNo   String?
  accountName String?
  charge      Decimal?  @db.Decimal(10, 2)
  reference   String?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  customer    Customer  @relation(fields: [customerId], references: [id])
  invoices    Invoice[]

  @@schema("admin")
}

model SalesOrder {
  id               String           @id @default(cuid())
  orderNumber      String           @unique
  customerId       String
  orderType        SalesOrderType
  status           SalesOrderStatus @default(PENDING)
  orderedAt        DateTime?
  actionDate       DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  customerPO       String?
  internalNotes    String?
  externalNotes    String?
  priceLevel       PriceLevel
  salesFactor      Decimal?         @db.Decimal(6, 2)
  freight          Decimal?         @db.Decimal(10, 2)
  sundries         Decimal?         @db.Decimal(10, 2)
  discountPct      Decimal?         @db.Decimal(5, 2)
  subtotal         Decimal?         @db.Decimal(12, 2)
  gst              Decimal?         @db.Decimal(12, 2)
  total            Decimal?         @db.Decimal(12, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  sameAsCustomer   Boolean?         @default(false)
  shippingAddress1 String?
  shippingAddress2 String?
  shippingAddress3 String?
  shippingName     String?
  billingAddress1  String?
  billingAddress2  String?
  billingAddress3  String?
  billingCity      String?
  billingCountry   String?
  billingName      String?
  billingPostcode  String?
  billingState     String?
  labour           Decimal?         @db.Decimal(10, 2)
  rounding         Decimal?         @db.Decimal(10, 2)
  otherCharges     Decimal?         @db.Decimal(10, 2)
  shippingCity     String?
  shippingCountry  String?
  shippingPostcode String?
  shippingState    String?
  paymentTerms     PaymentTerms?
  quotationId      String?
  dispatchMethod   String?
  invoices         Invoice[]
  pickingSlips     PickingSlip[]
  Quotation        Quotation[]      @relation("SalesOrderQuotations")
  customer         Customer         @relation(fields: [customerId], references: [id])
  fromQuotation    Quotation?       @relation("SOFromQuotation", fields: [quotationId], references: [id])
  items            SalesOrderItem[]

  @@schema("admin")
}

model SalesOrderItem {
  id                String     @id @default(cuid())
  salesOrderId      String
  description       String
  quantity          Int
  unitPrice         Decimal    @db.Decimal(10, 2)
  discountPct       Decimal?   @db.Decimal(5, 2)
  taxRate           Decimal?   @db.Decimal(5, 2)
  allocatedQty      Int        @default(0)
  backOrderQty      Int        @default(0)
  lineTotal         Decimal?   @db.Decimal(12, 2)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?
  productId         String
  landedCost        Int        @default(0)
  retailPrice       Int        @default(0)
  tradePrice        Int        @default(0)
  salesPartnerPrice Int        @default(0)
  agentPrice        Int        @default(0)
  product           Product    @relation(fields: [productId], references: [id])
  salesOrder        SalesOrder @relation(fields: [salesOrderId], references: [id])

  @@schema("admin")
}

model Invoice {
  id                   String                @id @default(cuid())
  invoiceNumber        String                @unique
  invoiceType          InvoiceType           @default(FREEHAND)
  customerId           String?
  salesOrderId         String?
  dispatchId           String?
  status               InvoiceStatus         @default(DRAFT)
  isProforma           Boolean               @default(false)
  subtotal             Decimal?              @db.Decimal(12, 2)
  gst                  Decimal?              @db.Decimal(12, 2)
  total                Decimal?              @db.Decimal(12, 2)
  balanceDue           Decimal?              @db.Decimal(12, 2)
  paidAmount           Decimal?              @db.Decimal(12, 2)
  paidAt               DateTime?
  issuedAt             DateTime?
  dueDate              DateTime?
  sentAt               DateTime?
  sentVia              String?
  freight              Decimal?              @db.Decimal(10, 2)
  sundries             Decimal?              @db.Decimal(10, 2)
  labour               Decimal?              @db.Decimal(10, 2)
  rounding             Decimal?              @db.Decimal(6, 2)
  otherCharges         Decimal?              @db.Decimal(10, 2)
  internalNotes        String?
  externalNotes        String?
  shippingName         String?
  shippingAddress1     String?
  shippingAddress2     String?
  shippingAddress3     String?
  shippingCity         String?
  shippingState        String?
  shippingPostcode     String?
  billingName          String?
  billingAddress1      String?
  billingAddress2      String?
  billingAddress3      String?
  billingCity          String?
  billingState         String?
  billingPostcode      String?
  reference            String?
  abnNumber            String?
  isLocked             Boolean               @default(false)
  reversalOfInvoiceId  String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  xeroInvoiceId        String?
  xeroSyncedAt         DateTime?
  subscriptionReportId String?
  DispatchedInvoices   DispatchedInvoices[]
  installationJobs     InstallationJob[]
  customer             Customer?             @relation(fields: [customerId], references: [id])
  dispatch             CustomerDispatch?     @relation(fields: [dispatchId], references: [id])
  reversalOf           Invoice?              @relation("InvoiceReversal", fields: [reversalOfInvoiceId], references: [id])
  reversals            Invoice[]             @relation("InvoiceReversal")
  salesOrder           SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  subscriptionReport   FMSubscriptionReport? @relation(fields: [subscriptionReportId], references: [id])
  items                InvoiceItem[]
  fmSubscriptionItems  fmSubscriptionItems[]

  @@schema("admin")
}

model PickingSlip {
  id           String            @id @default(cuid())
  slipNumber   String            @unique
  salesOrderId String
  status       PickingSlipStatus @default(DRAFT)
  pickedBy     String?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  salesOrder   SalesOrder        @relation(fields: [salesOrderId], references: [id])
  lines        PickingSlipLine[]

  @@schema("admin")
}

model PickingSlipLine {
  id            String      @id @default(cuid())
  pickingSlipId String
  productId     String
  description   String
  onHandQty     Decimal     @db.Decimal(12, 3)
  orderedQty    Int
  pickedQty     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  pickingSlip   PickingSlip @relation(fields: [pickingSlipId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])

  @@schema("admin")
}

model InvoiceItem {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  invoiceId    String
  productId    String
  description  String
  quantity     Int
  backorderQty Int       @default(0)
  unitPrice    Decimal   @db.Decimal(10, 2)
  discountPct  Decimal?  @db.Decimal(5, 2)
  lineTotal    Decimal?  @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  deletedAt    DateTime?
  invoice      Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product      Product   @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("admin")
}

model CommentThread {
  id         String    @id @default(uuid())
  entityType String
  entityId   String
  createdAt  DateTime  @default(now())
  comments   Comment[]

  @@schema("admin")
}

model Comment {
  id            String        @id @default(uuid())
  threadId      String
  message       String
  createdBy     String
  createdAt     DateTime      @default(now())
  createdByName String?
  type          CommentType   @default(COMMENT)
  thread        CommentThread @relation(fields: [threadId], references: [id])

  @@schema("admin")
}

model FMCustomer {
  id                   String                  @id @default(cuid())
  customerId           String                  @unique
  fmWebNumber          String?                 @unique
  fleetName            String?
  mixOrgId             String?
  mixDBase             String?
  priceLevel           PriceLevel
  priceFactor          Int                     @default(1000)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  depots               String?
  invPeriod            String?
  invoiceBy            String?
  listBy               String?
  sortBy               String?
  volOffset            String?
  customer             Customer                @relation(fields: [customerId], references: [id])
  options              FMCustomerOption[]
  FMCustomerOrgIds     FMCustomerOrgIds[]
  services             FMCustomerService[]
  cameraSimMixServices FMCustomerServiceItem[]
  preinstalls          FMPreinstall[]
  subscriptionReports  FMSubscriptionReport[]

  @@schema("admin")
}

model FMCustomerService {
  id            String     @id @default(cuid())
  fmCustomerId  String
  numItems      Int        @default(0)
  active        Int        @default(0)
  charge        Int        @default(0)
  monthlyCharge Int        @default(0)
  price         Decimal    @db.Decimal(10, 2)
  isActive      Boolean    @default(true)
  productId     String
  fmCustomer    FMCustomer @relation(fields: [fmCustomerId], references: [id])
  product       Product    @relation(fields: [productId], references: [id])

  @@unique([fmCustomerId, productId])
  @@schema("admin")
}

model FMOption {
  id              String             @id @default(cuid())
  code            String             @unique
  label           String
  hasCharge       Boolean            @default(true)
  hasVehicleCount Boolean            @default(true)
  isActive        Boolean            @default(true)
  sortOrder       Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  customerOptions FMCustomerOption[]

  @@schema("admin")
}

model FMCustomerOption {
  id           String     @id @default(cuid())
  fmCustomerId String
  optionId     String
  enabled      Boolean    @default(false)
  charge       Decimal?   @db.Decimal(10, 2)
  vehicleCount Int?
  fmCustomer   FMCustomer @relation(fields: [fmCustomerId], references: [id])
  option       FMOption   @relation(fields: [optionId], references: [id])

  @@unique([fmCustomerId, optionId])
  @@schema("admin")
}

model FMServiceMaster {
  id               String                  @id @default(cuid())
  code             String                  @unique
  label            String
  type             FMServiceType
  hasActive        Boolean                 @default(false)
  hasPrice         Boolean                 @default(true)
  isActive         Boolean                 @default(true)
  sortOrder        Int?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  customerServices FMCustomerServiceItem[]

  @@schema("admin")
}

model FMCustomerServiceItem {
  id            String          @id @default(cuid())
  fmCustomerId  String
  serviceId     String
  numItems      Int             @default(0)
  active        Int?
  price         Decimal?        @db.Decimal(10, 2)
  monthlyCharge Decimal?        @db.Decimal(10, 2)
  fmCustomer    FMCustomer      @relation(fields: [fmCustomerId], references: [id])
  service       FMServiceMaster @relation(fields: [serviceId], references: [id])

  @@unique([fmCustomerId, serviceId])
  @@schema("admin")
}

model JobBoard {
  id           String             @id @default(cuid())
  name         String
  color        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  description  String?
  userId       String?
  customFields BoardCustomField[]
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lists        JobList[]

  @@index([userId])
  @@index([deletedAt])
  @@schema("admin")
}

model JobList {
  id        String    @id @default(cuid())
  boardId   String
  name      String
  sortOrder Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  color     String?
  cards     JobCard[]
  board     JobBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([sortOrder])
  @@schema("admin")
}

model JobCard {
  id                String                 @id @default(cuid())
  listId            String
  title             String
  description       String?
  dueDate           DateTime?
  sortOrder         Int
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  activities        CardActivity[]
  attachments       CardAttachment[]
  checklists        CardChecklist[]
  customFieldValues CardCustomFieldValue[]
  labels            CardLabel[]
  members           CardMember[]
  list              JobList                @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([sortOrder])
  @@schema("admin")
}

model Product {
  id                  String              @id @default(cuid())
  name                String
  productCode         String              @unique
  parentProductId     String?
  productCategory     String?
  status              String?
  replacedBy          String?
  billOfGoods         Boolean             @default(false)
  fieldServiceType    String?
  decimalsSupported   Boolean             @default(false)
  defaultUnit         String?
  unitGroup           String?
  vendorName          String?
  vendorNumber        String?
  vendorWeb           String?
  vendorPartNumber    String?
  reorderLogic        String?
  automaticMaxQty     Int?
  automaticMinQty     Int?
  fixedMinQty         Int?
  fixedMaxQty         Int?
  isFmHardware        Boolean             @default(false)
  isMonitor           Boolean             @default(false)
  fmMixCode           String?
  fmUnitCode          String?
  fourGUnitModem      Boolean             @default(false)
  mixUnitSim          Boolean             @default(false)
  fuelRebate          Boolean             @default(false)
  internSim           Boolean             @default(false)
  rimOption           Boolean             @default(false)
  nrcOption           Boolean             @default(false)
  tmaOption           Boolean             @default(false)
  isVision            Boolean             @default(false)
  vision4GDevice      Boolean             @default(false)
  standardVision      Boolean             @default(false)
  highDefinition      Boolean             @default(false)
  aiOption            Boolean             @default(false)
  cameraCount         Int?
  mixVisSim           Boolean             @default(false)
  vision4GModem       Boolean             @default(false)
  netSupplierBuyPrice Decimal?            @db.Decimal(12, 2)
  importDuty          Decimal?            @db.Decimal(6, 2)
  importMarkup        Decimal?            @db.Decimal(6, 2)
  landedCost          Decimal?            @db.Decimal(12, 2)
  aircoMarkupGroup    String?
  agentPrice          Decimal?            @db.Decimal(12, 2)
  salesPartnerPrice   Decimal?            @db.Decimal(12, 2)
  tradePrice          Decimal?            @db.Decimal(12, 2)
  retailPrice         Decimal?            @db.Decimal(12, 2)
  salesMargin         Decimal?            @db.Decimal(6, 2)
  sellingPrice        Decimal?            @db.Decimal(12, 2)
  gstPercent          Decimal?            @db.Decimal(5, 2)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  isActive            Boolean             @default(true)
  description         String?
  extendedDescription String?
  itemType            String?
  orderRank           String?
  weight              Decimal?            @db.Decimal(10, 3)
  volume              Decimal?            @db.Decimal(10, 3)
  barcode             String?
  onHand              Decimal             @default(0) @db.Decimal(12, 3)
  committed           Decimal             @default(0) @db.Decimal(12, 3)
  backOrdered         Decimal             @default(0) @db.Decimal(12, 3)
  onOrder             Decimal             @default(0) @db.Decimal(12, 3)
  supplierStock       Decimal             @default(0) @db.Decimal(12, 3)
  minStock            Decimal?            @db.Decimal(12, 3)
  maxStock            Decimal?            @db.Decimal(12, 3)
  reorderPoint        Decimal?            @db.Decimal(12, 3)
  reorderQty          Decimal?            @db.Decimal(12, 3)
  averageCost         Decimal?            @db.Decimal(12, 4)
  standardCost        Decimal?            @db.Decimal(12, 4)
  isTaxable           Boolean             @default(true)
  isWeighed           Boolean             @default(false)
  isSerialized        Boolean             @default(false)
  allowBackOrder      Boolean             @default(true)
  primarySupplierId   String?
  supplierCode        String?
  leadTimeDays        Int?
  lastStocktakeDate   DateTime?
  lastStocktakeQty    Decimal?            @db.Decimal(12, 3)
  notes               String?
  imageUrl            String?
  deletedAt           DateTime?
  xGroup              String?
  bin                 String?
  packSize            Int?
  grade               Int?
  fmRuleCode          String?
  landedFactor        Int?
  inStoreCost         Decimal?            @db.Decimal(12, 2)
  agentFactor         Decimal?            @db.Decimal(8, 4)
  partnerFactor       Decimal?            @db.Decimal(8, 4)
  tradeFactor         Decimal?            @db.Decimal(8, 4)
  retailFactor        Decimal?            @db.Decimal(8, 4)
  agentFactorLocked   Boolean             @default(false)
  partnerFactorLocked Boolean             @default(false)
  tradeFactorLocked   Boolean             @default(false)
  retailFactorLocked  Boolean             @default(false)
  aliasAction         String?             @default("no_action")
  fmCustomerServices  FMCustomerService[]
  fmPreinstallItems   FMPreinstallItem[]
  FMServiceSegment    FMServiceSegment[]
  invoiceItems        InvoiceItem[]
  pickingSlipLines    PickingSlipLine[]
  InvCategory         InvCategory?        @relation(fields: [productCategory], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "Category")
