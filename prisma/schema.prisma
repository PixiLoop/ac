model ChecklistTemplate {
  id            String                     @id @default(cuid())
  name          String
  hardwareType  String
  hardwareModel HardwareModel
  category      HardwareCategory
  description   String
  version       String                     @default("v1.0")
  status        TemplateStatus             @default(ACTIVE)
  lastUpdated   DateTime                   @default(now())
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  sections      ChecklistTemplateSection[]

  @@index([hardwareModel])
  @@index([status])
  @@schema("admin")
}

model ChecklistTemplateSection {
  id           String                  @id @default(cuid())
  templateId   String
  title        String
  displayOrder Int                     @default(1)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  items        ChecklistTemplateItem[]
  template     ChecklistTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, displayOrder])
  @@index([templateId])
  @@schema("admin")
}

model ChecklistTemplateItem {
  id           String                   @id @default(cuid())
  sectionId    String
  title        String
  description  String?
  isRequired   Boolean                  @default(true)
  displayOrder Int                      @default(1)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  section      ChecklistTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  jobItems     JobChecklistItem[]

  @@unique([sectionId, displayOrder])
  @@index([sectionId])
  @@schema("admin")
}

model JobChecklistItem {
  id               String                 @id @default(cuid())
  sectionId        String
  templateItemId   String?
  title            String
  description      String?
  section          String
  hardwareModel    HardwareModel?
  isRequired       Boolean                @default(true)
  displayOrder     Int                    @default(1)
  completed        Boolean                @default(false)
  completedById    String?
  completedByName  String?
  completedAt      DateTime?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  checklistSection JobChecklistSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  templateItem     ChecklistTemplateItem? @relation(fields: [templateItemId], references: [id])

  @@index([sectionId])
  @@index([completed])
  @@index([isRequired])
  @@schema("admin")
}

model JobChecklistSection {
  id            String             @id @default(cuid())
  jobId         String
  title         String
  hardwareModel HardwareModel?
  hardwareName  String?
  displayOrder  Int                @default(1)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  items         JobChecklistItem[]
  job           InstallationJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@schema("admin")
}

model InstallationJob {
  id                String                @id
  jobNumber         String                @unique
  customerId        String
  projectId         String
  vehicleId         String
  location          String
  technicianId      String?
  installationDate  DateTime?             @db.Date
  startTime         String?
  endTime           String?
  isScheduled       Boolean               @default(false)
  status            InstallationStatus    @default(NOT_ACTIONED)
  canInvoice        Boolean               @default(false)
  notes             String?
  createdById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  invoiceId         String?
  userId            String?
  hardware          HardwareItem[]
  createdBy         User?                 @relation("JobCreator", fields: [createdById], references: [id])
  customer          Customer              @relation(fields: [customerId], references: [id])
  invoice           Invoice?              @relation(fields: [invoiceId], references: [id])
  user              User?                 @relation(fields: [userId], references: [id])
  vehicle           Vehicle               @relation(fields: [vehicleId], references: [id])
  checklistSections JobChecklistSection[]
  timeline          JobTimelineEvent[]

  @@index([status])
  @@index([technicianId, installationDate])
  @@index([installationDate])
  @@index([customerId])
  @@index([projectId])
  @@index([vehicleId])
  @@schema("admin")
}

model JobTimelineEvent {
  id            String             @id @default(cuid())
  jobId         String
  status        InstallationStatus
  timestamp     DateTime           @default(now())
  updatedById   String?
  updatedByName String
  note          String?
  userId        String?
  job           InstallationJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  updatedBy     User?              @relation("TimelineActor", fields: [updatedById], references: [id])
  user          User?              @relation(fields: [userId], references: [id])

  @@index([jobId])
  @@index([timestamp])
  @@schema("admin")
}

model HardwareItem {
  id              String                  @id @default(cuid())
  model           HardwareModel
  name            String
  category        HardwareCategory
  serialNumber    String                  @unique
  imei            String?                 @unique
  iccid           String?
  macAddress      String?
  firmwareVersion String?
  status          HardwareInventoryStatus @default(IN_STOCK)
  depotLocation   String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  allocatedJobId  String?
  job             InstallationJob?        @relation(fields: [allocatedJobId], references: [id])

  @@index([model])
  @@index([category])
  @@index([status])
  @@index([allocatedJobId])
  @@schema("admin")
}

model Vehicle {
  id              String            @id @default(cuid())
  customerId      String
  rego            String
  fleetNumber     String
  vin             String            @unique
  makeModel       String
  year            Int?
  fuelType        String?
  odometerReading Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  jobs            InstallationJob[]
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([rego])
  @@index([fleetNumber])
  @@schema("admin")
}

